<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Unveil.Cli</AssemblyName>
    <RootNamespace>Unveil.Cli</RootNamespace>
  </PropertyGroup>

  <!--
    Publish settings live here, not in a .pubxml (see CLAUDE.md).
    `dotnet publish -c Release -r win-x64` (or win-arm64) produces one self-contained exe.
  -->
  <PropertyGroup>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Unveil.Core\Unveil.Core.csproj" />
    <ProjectReference Include="..\Unveil.CommandLine\Unveil.CommandLine.csproj" />
  </ItemGroup>

</Project>
