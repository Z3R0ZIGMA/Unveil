<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Unveil desktop app (WPF). The final exe is Unveil.exe. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>Unveil</AssemblyName>
    <RootNamespace>Unveil.App</RootNamespace>
    <ApplicationIcon>unveil.ico</ApplicationIcon>
    <!-- Program.Main runs the no-window N-sight mode (rmm) before any WPF starts -->
    <StartupObject>Unveil.App.Program</StartupObject>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <!--
    Publish settings live here, not in a .pubxml (see DEVELOPMENT.md).
    `dotnet publish src/Unveil.App -c Release -r win-x64` (or win-arm64) produces one self-contained Unveil.exe.
  -->
  <PropertyGroup>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="unveil.ico" />
    <Resource Include="unveil.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Unveil.Core\Unveil.Core.csproj" />
  </ItemGroup>

</Project>
