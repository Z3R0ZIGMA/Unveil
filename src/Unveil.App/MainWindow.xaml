<Window x:Class="Unveil.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Unveil.App.ViewModels"
        xmlns:c="clr-namespace:Unveil.App.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding AppTitle, FallbackValue=Unveil}" Icon="unveil.ico"
        Style="{StaticResource UnveilWindow}"
        Width="1200" Height="880" MinWidth="980" MinHeight="600"
        WindowStartupLocation="Manual">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel x:Name="Root" Background="{StaticResource Window}">
            <StackPanel Margin="28,20,28,28">

                <!-- ============================================ header -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Source="unveil.png" Width="40" Height="40" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Unveil" Style="{StaticResource TitleText}" FontSize="22" />
                            <TextBlock Text="{Binding AppVersion}" Style="{StaticResource MutedText}" FontSize="14"
                                       VerticalAlignment="Bottom" Margin="8,0,0,4" ToolTip="Unveil version" />
                        </StackPanel>
                        <TextBlock Text="See what's really draining your battery." Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding DeviceTitle}" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding DeviceSubtitle}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                                   Visibility="{Binding DeviceSubtitle, Converter={StaticResource NullToCollapsed}}" />
                        <TextBlock Text="{Binding BatterySubtitle}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                                   Visibility="{Binding BatterySubtitle, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </Grid>

                <!-- ============================================ toolbar -->
                <DockPanel Margin="0,0,0,14" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Command="{Binding RestartAsAdminCommand}" Margin="0,0,8,0"
                                Visibility="{Binding IsAdministrator, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                ToolTip="Adds energy use by app over recent days, the sleep study and Windows energy diagnostics">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE7EF;" Margin="0,0,8,0" />
                                <TextBlock Text="Restart as administrator" />
                            </StackPanel>
                        </Button>
                        <Button Content="Copy summary" Command="{Binding CopySummaryCommand}" Margin="0,0,8,0"
                                ToolTip="Copy a short plain-text summary for a ticket" />
                        <Button Content="Export report" Command="{Binding ExportCommand}" Margin="0,0,8,0"
                                ToolTip="Save the HTML report for the customer (and the JSON data)" />
                        <Button Content="Check again" Command="{Binding RefreshCommand}" Margin="0,0,8,0"
                                ToolTip="Collect the battery data again" />
                        <Button Content="Run full test" Command="{Binding RunTestCommand}" Style="{StaticResource PrimaryButton}"
                                ToolTip="Unplug, then measure the power draw and the apps using the most power for 60 seconds" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>


                <!-- ============================================ full test panel -->
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius}" Padding="22,18" Margin="0,0,0,14"
                        Visibility="{Binding IsTestActive, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <!-- Step 1: unplug -->
                        <Grid Visibility="{Binding IsWaitingForUnplug, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="44" Height="44" VerticalAlignment="Top" Margin="0,0,16,0">
                                <Ellipse Fill="{StaticResource Accent}" />
                                <TextBlock Style="{StaticResource IconText}" FontSize="20" Foreground="{StaticResource SelectionText}" Text="&#xE945;" />
                            </Grid>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="STEP 1 OF 2" Style="{StaticResource CapsLabel}" />
                                <TextBlock Text="Unplug the charger" Style="{StaticResource TitleText}" FontSize="20" />
                                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,12"
                                           Text="The test measures the power draw on battery, so unplug the charger. It starts by itself as soon as the laptop is on battery." />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Laptop type" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <ComboBox Width="250" ItemsSource="{Binding MachineClassOptions}" DisplayMemberPath="Name"
                                              SelectedValuePath="Value" SelectedValue="{Binding SelectedMachineClass}"
                                              ToolTip="Sets what counts as a normal power draw" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="16,0,0,0">
                                <Button Content="Test while plugged in" Command="{Binding SkipUnplugCommand}" Margin="0,0,0,8"
                                        ToolTip="Measure app activity only; the power draw can't be measured on AC" />
                                <Button Content="Cancel" Command="{Binding CancelTestCommand}" />
                            </StackPanel>
                        </Grid>

                        <!-- Getting ready -->
                        <StackPanel Visibility="{Binding IsPreparing, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="STEP 2 OF 2" Style="{StaticResource CapsLabel}" />
                            <TextBlock Text="Getting ready..." Style="{StaticResource TitleText}" FontSize="20" />
                            <TextBlock Style="{StaticResource MutedText}" Text="Preparing the process counters. This can take a few seconds the first time." />
                        </StackPanel>

                        <!-- Step 2: measuring -->
                        <Grid Visibility="{Binding IsMeasuring, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="260" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="STEP 2 OF 2" Style="{StaticResource CapsLabel}" />
                                <TextBlock Text="Measuring power draw" Style="{StaticResource TitleText}" FontSize="20" />
                                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,12"
                                           Text="Leave the laptop idle: don't type, move the mouse or open apps until the test finishes." />
                                <ProgressBar Value="{Binding TestProgress, Mode=OneWay}" Maximum="100" Margin="0,0,0,6" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelTestCommand}" Padding="12,4" />
                                    <TextBlock Text="{Binding TestTimeLeft}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="POWER DRAW NOW" Style="{StaticResource CapsLabel}" />
                                <TextBlock Text="{Binding TestWattsText}" Style="{StaticResource BigNumber}" FontSize="30" />
                                <c:Sparkline Values="{Binding TestWattHistory}" Capacity="30" Height="40" Margin="0,2,0,4"
                                             LineBrush="{StaticResource Accent}" BaselineBrush="{StaticResource Border}" />
                                <TextBlock Text="{Binding TestAverageText}" Style="{StaticResource MutedText}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============================================ loading -->
                <Border Style="{StaticResource Card}" Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVis}}" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Checking the battery..." Style="{StaticResource HeadingText}" />
                        <TextBlock Style="{StaticResource MutedText}"
                                   Text="Reading Windows battery data and the battery report. This takes a few seconds." />
                    </StackPanel>
                </Border>

                <StackPanel Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">

                    <!-- ============================================ verdict -->
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius}" Margin="0,0,0,14" ClipToBounds="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{Binding VerdictSeverity, Converter={StaticResource SeverityBrush}}" CornerRadius="5,0,0,5" />
                            <Grid Grid.Column="1" Margin="20,18,22,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="44" Height="44" VerticalAlignment="Top" Margin="0,2,16,0">
                                    <Ellipse Fill="{Binding VerdictSeverity, Converter={StaticResource SeverityBrush}}" />
                                    <TextBlock Style="{StaticResource IconText}" FontSize="20" Foreground="{StaticResource Window}"
                                               Text="{Binding VerdictSeverity, Converter={StaticResource SeverityGlyph}}" />
                                </Grid>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding VerdictSeverity, Converter={StaticResource SeverityLabel}, ConverterParameter=upper}" Style="{StaticResource CapsLabel}" FontSize="12" />
                                    <TextBlock Text="{Binding VerdictTitle}" Style="{StaticResource TitleText}" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding VerdictMessage}" Style="{StaticResource BodyText}" FontSize="15" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Width="340" Margin="24,0,0,0">
                                    <TextBlock Text="What to do" Style="{StaticResource HeadingText}" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding Actions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="&#x203A;" Foreground="{StaticResource Accent}" FontWeight="Bold" />
                                                    <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource BodyText}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ============================================ three cards -->
                    <Grid Visibility="{Binding HasBattery, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Health -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding HealthCardTitle}" Style="{StaticResource HeadingText}" />
                                <Grid Width="150" Height="150" HorizontalAlignment="Center" Margin="0,4,0,6">
                                    <c:HealthGauge Value="{Binding HealthValue}" Thickness="13" TrackBrush="{StaticResource Border}"
                                                   FillBrush="{Binding HealthSeverity, Converter={StaticResource SeverityBrush}}" />
                                    <TextBlock Text="{Binding HealthText}" Style="{StaticResource BigNumber}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                                    <Grid Width="18" Height="18" Margin="0,0,6,0">
                                        <Ellipse Fill="{Binding HealthSeverity, Converter={StaticResource SeverityBrush}}" />
                                        <TextBlock Style="{StaticResource IconText}" FontSize="10" Foreground="{StaticResource Window}"
                                                   Text="{Binding HealthSeverity, Converter={StaticResource SeverityGlyph}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding HealthLabelText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding CapacityText}" Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,0,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Charge cycles" Style="{StaticResource MutedText}" Margin="0,3,16,3" />
                                    <TextBlock Grid.Column="1" Text="{Binding CyclesText}" Style="{StaticResource BodyText}" Margin="0,3" />
                                    <TextBlock Grid.Row="1" Text="Chemistry" Style="{StaticResource MutedText}" Margin="0,3,16,3" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ChemistryText}" Style="{StaticResource BodyText}" Margin="0,3" />
                                    <TextBlock Grid.Row="2" Text="Age" Style="{StaticResource MutedText}" Margin="0,3,16,3" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AgeText}" Style="{StaticResource BodyText}" Margin="0,3" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Live -->
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Right now" Style="{StaticResource HeadingText}" />
                                <DockPanel Margin="0,4,0,8">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding ChargeText}" Style="{StaticResource BigNumber}" />
                                    <TextBlock Text="charged" Style="{StaticResource MutedText}" VerticalAlignment="Bottom" Margin="8,0,0,9" />
                                </DockPanel>
                                <ProgressBar Value="{Binding ChargeValue, Mode=OneWay}" Maximum="100" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE945;" Foreground="{StaticResource Muted}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding PowerText}" Style="{StaticResource BodyText}" />
                                </StackPanel>

                                <!-- On battery: live draw and runtime -->
                                <StackPanel Visibility="{Binding IsOnBattery, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="POWER DRAW" Style="{StaticResource CapsLabel}" />
                                    <TextBlock Text="{Binding WattsText}" Style="{StaticResource BigNumber}" FontSize="30" />
                                    <c:Sparkline Values="{Binding WattHistory}" Height="44" Margin="0,4,0,10"
                                                 LineBrush="{StaticResource Accent}" BaselineBrush="{StaticResource Border}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition /><RowDefinition /><RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Time left at this rate" Style="{StaticResource MutedText}" Margin="0,2" />
                                        <TextBlock Grid.Column="1" Text="{Binding TimeLeftText}" FontWeight="SemiBold" Margin="0,2" />
                                        <TextBlock Grid.Row="1" Text="A full charge lasts" Style="{StaticResource MutedText}" Margin="0,2" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RuntimeNowText}" FontWeight="SemiBold" Margin="0,2" />
                                        <TextBlock Grid.Row="2" Text="If the battery were new" Style="{StaticResource MutedText}" Margin="0,2" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RuntimeNewText}" FontWeight="SemiBold" Margin="0,2" />
                                    </Grid>
                                </StackPanel>

                                <!-- Plugged in -->
                                <Border Visibility="{Binding IsOnBattery, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                        BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="12,10">
                                    <TextBlock Style="{StaticResource MutedText}"
                                               Text="Unplug the charger to see the live power draw and how long a charge lasts at that rate." />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Recent use -->
                        <Border Grid.Column="4" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Recent use on battery" Style="{StaticResource HeadingText}" />
                                <TextBlock Text="IN USE" Style="{StaticResource CapsLabel}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding InUseWatts}" Style="{StaticResource BigNumber}" FontSize="30" />
                                <TextBlock Text="{Binding InUseDetail}" Style="{StaticResource MutedText}" Margin="0,0,0,14" />
                                <TextBlock Text="ASLEEP" Style="{StaticResource CapsLabel}" />
                                <TextBlock Text="{Binding AsleepWatts}" Style="{StaticResource BigNumber}" FontSize="30" />
                                <TextBlock Text="{Binding AsleepDetail}" Style="{StaticResource MutedText}" Margin="0,0,0,14" />
                                <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                    <TextBlock Text="{Binding EstimateText}" Style="{StaticResource MutedText}" />
                                </Border>
                                <TextBlock Text="From the Windows battery report: how this laptop was actually used over the last few days."
                                           Style="{StaticResource MutedText}" FontSize="12" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ============================================ comparison with an earlier report (Phase 8) -->
                    <Border Style="{StaticResource Card}" Visibility="{Binding HasBattery, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Content="Clear" Command="{Binding ClearComparisonCommand}" Margin="0,0,8,0"
                                            Visibility="{Binding HasComparison, Converter={StaticResource BoolToVis}}"
                                            ToolTip="Stop comparing with this report" />
                                    <Button Content="Compare with a report..." Command="{Binding CompareWithCommand}"
                                            ToolTip="Choose an earlier Unveil report (.json) for this laptop" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding ComparisonTitle}" Style="{StaticResource HeadingText}" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding ComparisonSource}" Style="{StaticResource MutedText}" FontSize="12"
                                               Visibility="{Binding HasComparison, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </DockPanel>

                            <TextBlock Text="{Binding ComparisonEmptyText}" Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                       Visibility="{Binding HasComparison, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                            <StackPanel Visibility="{Binding HasComparison, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding ComparisonSummary}" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,6,0,10" />
                                <DataGrid ItemsSource="{Binding ComparisonRows}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="" Binding="{Binding Label}" Width="2*" />
                                        <DataGridTextColumn Header="Then" Binding="{Binding Before}" Width="*"
                                                            CellStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}" />
                                        <DataGridTextColumn Header="Now" Binding="{Binding Now}" Width="*"
                                                            CellStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}" />
                                        <DataGridTextColumn Header="Change" Binding="{Binding Change}" Width="*"
                                                            CellStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="{Binding ComparisonNotes}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ============================================ power settings (Phase 6) -->
                    <Border Style="{StaticResource Card}" Visibility="{Binding HasSettings, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Power settings" Style="{StaticResource HeadingText}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding SettingsSummary}" Style="{StaticResource MutedText}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding SettingRows}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SettingRow}">
                                        <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="0,7" Margin="0,0,24,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="18" Height="18" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,1,0,0"
                                                      ToolTip="{Binding Severity, Converter={StaticResource SeverityLabel}}">
                                                    <Ellipse Fill="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                                    <TextBlock Style="{StaticResource IconText}" FontSize="10" Foreground="{StaticResource Window}"
                                                               Text="{Binding Severity, Converter={StaticResource SeverityGlyph}}" />
                                                </Grid>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource MutedText}" FontSize="14" Margin="0,0,12,0" />
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding Value}" Style="{StaticResource BodyText}" />
                                                    <TextBlock Text="{Binding Note}" Style="{StaticResource MutedText}" FontSize="12"
                                                               Visibility="{Binding Note, Converter={StaticResource NullToCollapsed}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ============================================ power hogs -->
                    <Border Style="{StaticResource Card}" Visibility="{Binding HasBattery, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                                            Visibility="{Binding HasActivity, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Laptop type" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <ComboBox Width="250" ItemsSource="{Binding MachineClassOptions}" DisplayMemberPath="Name"
                                              SelectedValuePath="Value" SelectedValue="{Binding SelectedMachineClass}"
                                              ToolTip="Sets what counts as a normal power draw; the verdict updates straight away" />
                                </StackPanel>
                                <TextBlock Text="Apps using the most power" Style="{StaticResource HeadingText}" />
                            </DockPanel>
                            <TabControl x:Name="PowerTabs">
                                <TabItem Header="Live test">
                                    <StackPanel>
                                        <!-- Before the test -->
                                        <DockPanel Visibility="{Binding HasActivity, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                            <Button DockPanel.Dock="Right" Content="Run full test" Command="{Binding RunTestCommand}"
                                                    Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" />
                                            <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,16,0"
                                                       Text="Run the full test to see which apps use the most power. It takes about a minute: unplug the charger and leave the laptop idle." />
                                        </DockPanel>

                                        <!-- After the test -->
                                        <StackPanel Visibility="{Binding HasActivity, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding ActivitySummary}" Style="{StaticResource MutedText}" Margin="0,0,0,10" />
                                            <Grid Margin="8,0,8,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="3*" />
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1" Text="App" Style="{StaticResource MutedText}" />
                                                <TextBlock Grid.Column="2" Text="Share of power" Style="{StaticResource MutedText}" />
                                                <TextBlock Grid.Column="3" Text="CPU" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="4" Text="GPU" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="5" Text="Disk + network" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" />
                                            <ItemsControl ItemsSource="{Binding Apps}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:AppRow}">
                                                        <StackPanel>
                                                            <Button Style="{StaticResource RowButton}" Command="{Binding ToggleCommand}"
                                                                    ToolTip="{Binding Advice}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="28" />
                                                                        <ColumnDefinition Width="3*" />
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="70" />
                                                                        <ColumnDefinition Width="70" />
                                                                        <ColumnDefinition Width="110" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock x:Name="Chevron" Style="{StaticResource IconText}" FontSize="10" Text="&#xE76C;"
                                                                               Foreground="{StaticResource Muted}" HorizontalAlignment="Left" />
                                                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding ProcessCountText}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,10,0"
                                                                                       Visibility="{Binding ProcessCountText, Converter={StaticResource NullToCollapsed}}" />
                                                                            <StackPanel Orientation="Horizontal" Visibility="{Binding Category, Converter={StaticResource NullToCollapsed}}">
                                                                                <Grid Width="14" Height="14" Margin="0,0,5,0">
                                                                                    <Ellipse Fill="{StaticResource Warning}" />
                                                                                    <TextBlock Style="{StaticResource IconText}" FontSize="8" Foreground="{StaticResource Window}" Text="&#xE7BA;" />
                                                                                </Grid>
                                                                                <TextBlock Text="{Binding Category}" Style="{StaticResource MutedText}" FontSize="12" />
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                    <DockPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ShareText}" Width="42" TextAlignment="Right" FontWeight="SemiBold" />
                                                                        <ProgressBar Value="{Binding Share, Mode=OneWay}" Maximum="100" Margin="0,0,10,0" />
                                                                    </DockPanel>
                                                                    <TextBlock Grid.Column="3" Text="{Binding CpuText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="4" Text="{Binding GpuText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="5" Text="{Binding IoText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                                </Grid>
                                                            </Button>

                                                            <!-- Expanded: advice and the individual processes -->
                                                            <StackPanel Margin="36,0,8,10" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{Binding Advice}" Style="{StaticResource BodyText}" FontSize="13" Margin="0,0,0,6"
                                                                           Visibility="{Binding Advice, Converter={StaticResource NullToCollapsed}}" />
                                                                <ItemsControl ItemsSource="{Binding Processes}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate DataType="{x:Type vm:ProcessRow}">
                                                                            <Grid Margin="0,1">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="90" />
                                                                                    <ColumnDefinition Width="70" />
                                                                                    <ColumnDefinition Width="70" />
                                                                                    <ColumnDefinition Width="110" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{Binding Name}" Style="{StaticResource MutedText}" FontSize="12" />
                                                                                <TextBlock Grid.Column="1" Text="{Binding Pid, StringFormat=PID {0}}" Style="{StaticResource MutedText}" FontSize="12" />
                                                                                <TextBlock Grid.Column="2" Text="{Binding Cpu}" Style="{StaticResource MutedText}" FontSize="12" HorizontalAlignment="Right" />
                                                                                <TextBlock Grid.Column="3" Text="{Binding Gpu}" Style="{StaticResource MutedText}" FontSize="12" HorizontalAlignment="Right" />
                                                                                <TextBlock Grid.Column="4" Text="{Binding Io}" Style="{StaticResource MutedText}" FontSize="12" HorizontalAlignment="Right" />
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="8,8,0,0"
                                                       Text="Power Impact is an estimate from CPU (60%), GPU (30%) and disk/network activity (10%). Click an app to see its processes." />
                                        </StackPanel>
                                    </StackPanel>
                                </TabItem>
                                <TabItem Header="Last 24 hours">
                                    <StackPanel>
                                        <DockPanel Visibility="{Binding HasSrum, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                            <Button DockPanel.Dock="Right" Command="{Binding RestartAsAdminCommand}" Content="Restart as administrator" VerticalAlignment="Center"
                                                    Visibility="{Binding IsAdministrator, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                            <TextBlock Text="{Binding AdminHint}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                        </DockPanel>
                                        <StackPanel Visibility="{Binding HasSrum, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding SrumDaySummary}" Style="{StaticResource MutedText}" Margin="0,0,0,10" />
                                            <Grid Margin="8,0,8,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="3*" />
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1" Text="App" Style="{StaticResource MutedText}" />
                                                <TextBlock Grid.Column="2" Text="Share of app energy" Style="{StaticResource MutedText}" />
                                                <TextBlock Grid.Column="3" Text="Mostly" Style="{StaticResource MutedText}" />
                                                <TextBlock Grid.Column="4" Text="In background" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" />
                                            <ItemsControl ItemsSource="{Binding SrumDay}">
                                                <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:SrumRow}">
                                                    <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="8,6" ToolTip="{Binding Advice}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28" />
                                                                <ColumnDefinition Width="3*" />
                                                                <ColumnDefinition Width="2*" />
                                                                <ColumnDefinition Width="90" />
                                                                <ColumnDefinition Width="110" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Rank}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                                <StackPanel Orientation="Horizontal" Visibility="{Binding Category, Converter={StaticResource NullToCollapsed}}">
                                                                    <Grid Width="14" Height="14" Margin="0,0,5,0">
                                                                        <Ellipse Fill="{StaticResource Warning}" />
                                                                        <TextBlock Style="{StaticResource IconText}" FontSize="8" Foreground="{StaticResource Window}" Text="&#xE7BA;" />
                                                                    </Grid>
                                                                    <TextBlock Text="{Binding Category}" Style="{StaticResource MutedText}" FontSize="12" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <DockPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ShareText}" Width="42" TextAlignment="Right" FontWeight="SemiBold" />
                                                                <ProgressBar Value="{Binding Share, Mode=OneWay}" Maximum="100" Margin="0,0,10,0" />
                                                            </DockPanel>
                                                            <TextBlock Grid.Column="3" Text="{Binding Mostly}" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="4" Text="{Binding BackgroundText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </TabItem>
                                <TabItem Header="{Binding SrumWeekHeader}">
                                    <StackPanel>
                                        <DockPanel Visibility="{Binding HasSrum, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                            <Button DockPanel.Dock="Right" Command="{Binding RestartAsAdminCommand}" Content="Restart as administrator" VerticalAlignment="Center"
                                                    Visibility="{Binding IsAdministrator, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                            <TextBlock Text="{Binding AdminHint}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                        </DockPanel>
                                        <StackPanel Visibility="{Binding HasSrum, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding SrumWeekSummary}" Style="{StaticResource MutedText}" Margin="0,0,0,10" />
                                            <Grid Margin="8,0,8,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="3*" />
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1" Text="App" Style="{StaticResource MutedText}" />
                                                <TextBlock Grid.Column="2" Text="Share of app energy" Style="{StaticResource MutedText}" />
                                                <TextBlock Grid.Column="3" Text="Mostly" Style="{StaticResource MutedText}" />
                                                <TextBlock Grid.Column="4" Text="In background" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" />
                                            <ItemsControl ItemsSource="{Binding SrumWeek}">
                                                <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:SrumRow}">
                                                    <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="8,6" ToolTip="{Binding Advice}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28" />
                                                                <ColumnDefinition Width="3*" />
                                                                <ColumnDefinition Width="2*" />
                                                                <ColumnDefinition Width="90" />
                                                                <ColumnDefinition Width="110" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Rank}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                                <StackPanel Orientation="Horizontal" Visibility="{Binding Category, Converter={StaticResource NullToCollapsed}}">
                                                                    <Grid Width="14" Height="14" Margin="0,0,5,0">
                                                                        <Ellipse Fill="{StaticResource Warning}" />
                                                                        <TextBlock Style="{StaticResource IconText}" FontSize="8" Foreground="{StaticResource Window}" Text="&#xE7BA;" />
                                                                    </Grid>
                                                                    <TextBlock Text="{Binding Category}" Style="{StaticResource MutedText}" FontSize="12" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <DockPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ShareText}" Width="42" TextAlignment="Right" FontWeight="SemiBold" />
                                                                <ProgressBar Value="{Binding Share, Mode=OneWay}" Maximum="100" Margin="0,0,10,0" />
                                                            </DockPanel>
                                                            <TextBlock Grid.Column="3" Text="{Binding Mostly}" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="4" Text="{Binding BackgroundText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </TabItem>
                                <TabItem Header="Asleep">
                                    <StackPanel>
                                        <DockPanel Visibility="{Binding HasSleep, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                            <Button DockPanel.Dock="Right" Command="{Binding RestartAsAdminCommand}" Content="Restart as administrator" VerticalAlignment="Center"
                                                    Visibility="{Binding IsAdministrator, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                            <TextBlock Text="{Binding AdminHint}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                        </DockPanel>
                                        <StackPanel Visibility="{Binding HasSleep, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding SleepSummary}" Style="{StaticResource MutedText}" Margin="0,0,0,10" />
                                            <DataGrid ItemsSource="{Binding SleepRows}" MaxHeight="320">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Started" Binding="{Binding Start}" Width="140" />
                                                    <DataGridTextColumn Header="Length" Binding="{Binding Length}" Width="80"
                                                                        CellStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}" />
                                                    <DataGridTextColumn Header="Power" Binding="{Binding Power}" Width="90" />
                                                    <DataGridTextColumn Header="Used" Binding="{Binding Used}" Width="90"
                                                                        CellStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}" />
                                                    <DataGridTextColumn Header="Per hour" Binding="{Binding PerHour}" Width="80"
                                                                        CellStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}" />
                                                    <DataGridTextColumn Header="Deep sleep" Binding="{Binding DeepSleep}" Width="90"
                                                                        CellStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}" />
                                                    <DataGridTextColumn Header="Kept awake most by" Binding="{Binding Blocker}" Width="*" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </StackPanel>
                                </TabItem>
                            </TabControl>
                        </StackPanel>
                    </Border>

                    <!-- ============================================ energy diagnostics (admin) -->
                    <Border Style="{StaticResource Card}" Visibility="{Binding HasBattery, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Command="{Binding RunEnergyCommand}" Content="Run energy diagnostics (60 s)"
                                            Visibility="{Binding IsAdministrator, Converter={StaticResource BoolToVis}}"
                                            ToolTip="Runs Windows' own 60-second power check (powercfg /energy)" />
                                    <Button Command="{Binding RestartAsAdminCommand}" Content="Restart as administrator"
                                            Visibility="{Binding IsAdministrator, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                </StackPanel>
                                <TextBlock Text="Windows energy diagnostics" Style="{StaticResource HeadingText}" Margin="0" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{Binding EnergyRunText}" Style="{StaticResource BodyText}" Margin="0,0,0,6"
                                       Visibility="{Binding EnergyRunning, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Style="{StaticResource MutedText}"
                                       Visibility="{Binding HasEnergy, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                       Text="Windows can check for power problems such as USB devices that never sleep, screens set to never turn off and drivers that block power saving. It takes 60 seconds and needs administrator rights." />
                            <StackPanel Visibility="{Binding HasEnergy, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding EnergySummary}" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding EnergyFindings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:EnergyFindingRow}">
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="18" Height="18" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,1,0,0"
                                                      ToolTip="{Binding Severity, Converter={StaticResource SeverityLabel}}">
                                                    <Ellipse Fill="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                                    <TextBlock Style="{StaticResource IconText}" FontSize="10" Foreground="{StaticResource Window}"
                                                               Text="{Binding Severity, Converter={StaticResource SeverityGlyph}}" />
                                                </Grid>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Style="{StaticResource BodyText}" />
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="12"
                                                               Visibility="{Binding Detail, Converter={StaticResource NullToCollapsed}}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ============================================ capacity history -->
                    <Border Style="{StaticResource Card}" Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Capacity history" Style="{StaticResource HeadingText}" Margin="0,0,0,2" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8"
                                       Text="How much the battery could hold when fully charged, in mWh. A steady, slow decline is normal ageing. Hover for values." />
                            <c:CapacityChart Entries="{Binding History}" Height="250"
                                             LineBrush="{StaticResource Accent}" GridBrush="{StaticResource Border}"
                                             AxisBrush="{StaticResource Muted}" LabelBrush="{StaticResource Text}"
                                             SurfaceBrush="{StaticResource Panel}" />
                        </StackPanel>
                    </Border>

                    <!-- ============================================ why -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Why" Style="{StaticResource HeadingText}" />
                            <ItemsControl ItemsSource="{Binding Evidence}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FindingItem}">
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="18" Height="18" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,1,0,0"
                                                  ToolTip="{Binding Severity, Converter={StaticResource SeverityLabel}}">
                                                <Ellipse Fill="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                                <TextBlock Style="{StaticResource IconText}" FontSize="10" Foreground="{StaticResource Window}"
                                                           Text="{Binding Severity, Converter={StaticResource SeverityGlyph}}" />
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource BodyText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ============================================ details -->
                    <Border Style="{StaticResource Card}">
                        <TabControl>
                            <TabItem Header="Details">
                                <ItemsControl ItemsSource="{Binding Details}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:DetailSection}">
                                            <StackPanel Margin="0,0,24,12">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource HeadingText}" Margin="0,0,0,6" />
                                                <ItemsControl ItemsSource="{Binding Rows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:DetailRow}">
                                                            <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="0,5">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="170" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource BodyText}" FontSize="13" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </TabItem>
                            <TabItem Header="Capacity history table">
                                <DataGrid ItemsSource="{Binding HistoryRows}" Height="300">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Period start" Binding="{Binding Date}" Width="2*" />
                                        <DataGridTextColumn Header="Full charge (mWh)" Binding="{Binding FullCharge}" Width="*"
                                                            CellStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}" />
                                        <DataGridTextColumn Header="Design (mWh)" Binding="{Binding Design}" Width="*"
                                                            CellStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}" />
                                        <DataGridTextColumn Header="Health" Binding="{Binding Health}" Width="*"
                                                            CellStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}" />
                                        <DataGridTextColumn Header="Cycles" Binding="{Binding Cycles}" Width="*"
                                                            CellStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Data notes">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding Notes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource BodyText}" FontSize="13" Margin="0,3" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Save samples..." Command="{Binding SaveSamplesCommand}" VerticalAlignment="Center"
                                                    ToolTip="Exports the raw data with serial numbers, names, account IDs and network IDs removed" />
                                            <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,16,0"
                                                       Text="Save scrubbed copies of the raw battery data (and, as administrator, the energy history, sleep study and energy diagnostics) to improve Unveil's support for this laptop model. Serial numbers, names, account IDs and Wi-Fi details are removed." />
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </Border>

                    <TextBlock Style="{StaticResource MutedText}" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"
                               Text="All data is collected on this computer. Nothing is sent anywhere." />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
