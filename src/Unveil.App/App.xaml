<Application x:Class="Unveil.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Unveil.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:SeverityToBrushConverter x:Key="SeverityBrush" />
            <conv:SeverityToGlyphConverter x:Key="SeverityGlyph" />
            <conv:SeverityToLabelConverter x:Key="SeverityLabel" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
